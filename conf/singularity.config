// Singularity / Apptainer software provisioning.
//
// Enabled via the `singularity` (local executor) or `singularity_slurm`
// (SLURM executor) profiles in nextflow.config. Combine with a site profile
// for queue names, e.g.:
//   -profile singularity_slurm,ucr_hpcc
//
// Images are pulled from the Bioconda/BioContainers registry on quay.io and
// cached in the directory given by the NXF_SINGULARITY_CACHEDIR environment
// variable (set it in your shell profile or sbatch script, e.g. a shared lab
// path so images aren't re-pulled per user):
//   export NXF_SINGULARITY_CACHEDIR=/bigdata/stajichlab/shared/singularity_cache
// On clusters whose compute nodes lack outbound network, pre-pull on a login
// node, e.g.:
//   singularity pull docker://ghcr.io/stajichlab/phyling:2.4.1
// or run the pipeline once on a networked node so Nextflow populates the cache.

params {
    phyling_image = 'ghcr.io/stajichlab/phyling:2.4.1'
}

singularity {
    enabled    = true
    autoMounts = true                       // auto-bind $HOME, $PWD, etc.
}

// Per-process container assignments. Kept here (rather than in each module's
// main.nf) so the entire container layer lives in one file and the modules
// stay provisioning-agnostic.
process {
    // phyling comes from the all-in-one stajichlab/phyling image (2.4.1), not the
    // 2.3.1 BioContainers image: that image's fasttree/FastTreeMP contain AVX2
    // instructions and die with SIGILL (illegal instruction) on UCR HPCC's older
    // AVX-only AMD Opteron 6376 nodes (no AVX2). The 2.4.1 image's FastTree has no
    // AVX instructions and ran correctly on AVX-only, AVX2 and AVX512 nodes.
    // CAVEAT: ASTRAL (used by PHYLING_TREE) in this image still contains AVX2
    // instructions and dies with SIGILL on those nodes, so keep PHYLING_TREE off
    // them on such clusters (see conf/ucr_hpcc.config). The image also has no `ps`,
    // which Nextflow needs for trace/timeline/report metrics, so those fail with
    // reporting enabled until the image includes procps. Override the tag with
    // --phyling_image.
    // The image ENTRYPOINT is bypassed by `singularity exec`, so PATH must
    // include the conda env's bin (same reason as conf/phyling_container.config).
    withName: 'PHYLING_DOWNLOAD|PHYLING_ALIGN|PHYLING_FILTER|PHYLING_TREE' {
        container        = params.phyling_image
        containerOptions = '--env PATH=/opt/conda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    }
    withName: 'PHYKIT_CONCAT' {
        container = 'quay.io/biocontainers/phykit:2.1.93--pyhdfd78af_0'
    }
    withName: 'MODELTEST_NG' {
        container = 'quay.io/biocontainers/modeltest-ng:0.1.7--hf316886_3'
    }
    // v3 image — the IQ-TREE modules invoke the `iqtree3` binary, which only
    // exists in the 3.x line (not the iqtree2 images).
    withName: 'IQTREE_MF|IQTREE_BOOTSTRAP' {
        container = 'quay.io/biocontainers/iqtree:3.1.2--h8471819_0'
    }
    // The OpenMP build (FastTreeMP binary) ships in the bioconda fasttree package.
    // Tested: runs on AVX-only (Opteron 6376) and AVX2 nodes with identical output.
    withName: 'FASTTREE' {
        container = 'quay.io/biocontainers/fasttree:2.2.0--h7b50bb2_1'
    }
    withName: 'RAXMLNG_PARSE|RAXMLNG_ALL' {
        container = 'quay.io/biocontainers/raxml-ng:2.0.2--h870a6a7_0'
        // container = 'quay.io/biocontainers/raxml-ng:1.2.2--h6747034_2'
    }
}
