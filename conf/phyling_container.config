// All-in-one "stajichlab/phyling" container image.
//
// Unlike conf/singularity.config (one small BioContainers image per tool),
// this profile runs phyling, phykit, IQ-TREE, RAxML-NG and FastTreeMP out of a
// single maintained image: ghcr.io/stajichlab/phyling. ModelTest-NG is NOT
// bundled in that image, so MODELTEST_NG still pulls its own BioContainers
// image, same as in conf/singularity.config.
//
// Enabled via the `phyling_container` (local executor) or
// `phyling_container_slurm` (SLURM executor) profiles in nextflow.config.
// Combine with a site profile for queue names, e.g.:
//   -profile phyling_container_slurm,ucr_hpcc
//
// Override the image tag on the command line if a newer one is published:
//   --phyling_image ghcr.io/stajichlab/phyling:2.5.0
//
// Images are cached in NXF_SINGULARITY_CACHEDIR as usual; on clusters whose
// compute nodes lack outbound network, pre-pull on a login node, e.g.:
//   singularity pull docker://ghcr.io/stajichlab/phyling:2.4.1

params {
    phyling_image = 'ghcr.io/stajichlab/phyling:2.4.1'
}

singularity {
    enabled    = true
    autoMounts = true                       // auto-bind $HOME, $PWD, etc.
}

process {
    // The image is built on a micromamba-docker base whose ENTRYPOINT
    // activates the conda env at /opt/conda before running the requested
    // command. `singularity/apptainer exec` — how Nextflow invokes every
    // process — bypasses ENTRYPOINT entirely and calls the task script
    // directly, so without this the container's own PATH (set for a bare
    // shell, not the activated env) can't find phyling/phykit/iqtree3/
    // raxml-ng/FastTreeMP at all. Force PATH to include the conda env's bin.
    withName: 'PHYLING_DOWNLOAD|PHYLING_ALIGN|PHYLING_FILTER|PHYLING_TREE|PHYKIT_CONCAT|IQTREE_MF|IQTREE_BOOTSTRAP|FASTTREE|RAXMLNG_PARSE|RAXMLNG_ALL' {
        container        = params.phyling_image
        containerOptions = '--env PATH=/opt/conda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    }

    // Not bundled in the phyling image — keep the dedicated BioContainers image.
    withName: 'MODELTEST_NG' {
        container = 'quay.io/biocontainers/modeltest-ng:0.1.7--hf316886_3'
    }
}
